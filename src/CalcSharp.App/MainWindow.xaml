<Window x:Class="CalcSharp.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calculator" Width="340" Height="520" MinWidth="320" MinHeight="500"
        Background="#202020" Foreground="White" FontFamily="Segoe UI"
        KeyDown="Window_KeyDown" TextInput="Window_TextInput">
    <Window.Resources>
        <SolidColorBrush x:Key="NumberBrush" Color="#3B3B3B"/>
        <SolidColorBrush x:Key="OperatorBrush" Color="#323232"/>
        <SolidColorBrush x:Key="EqualsBrush" Color="#4CC2FF"/>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="1"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="ExpressionText" Grid.Row="0" HorizontalAlignment="Right" Margin="8,8,8,0"
                   FontSize="14" Foreground="#C5C5C5" MinHeight="20"/>
        <Viewbox Grid.Row="1" Grid.RowSpan="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                 StretchDirection="DownOnly" Margin="8,0">
            <TextBlock x:Name="DisplayText" Text="0" FontSize="52" FontWeight="SemiBold"/>
        </Viewbox>

        <UniformGrid Grid.Row="3" Rows="1" Columns="6" x:Name="MemoryRow" Height="32">
            <Button Content="MC" Tag="MC" FontSize="12" Background="Transparent"/>
            <Button Content="MR" Tag="MR" FontSize="12" Background="Transparent"/>
            <Button Content="M+" Tag="M+" FontSize="12" Background="Transparent"/>
            <Button Content="M−" Tag="M-" FontSize="12" Background="Transparent"/>
            <Button Content="MS" Tag="MS" FontSize="12" Background="Transparent"/>
            <TextBlock x:Name="MemoryIndicator" Text="" HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="12" Foreground="#4CC2FF"/>
        </UniformGrid>

        <UniformGrid x:Name="Keypad" Grid.Row="4" Rows="6" Columns="4">
            <Button Content="%" Tag="%" Background="{StaticResource OperatorBrush}"/>
            <Button Content="CE" Tag="CE" Background="{StaticResource OperatorBrush}"/>
            <Button Content="C" Tag="C" Background="{StaticResource OperatorBrush}"/>
            <Button Content="⌫" Tag="⌫" Background="{StaticResource OperatorBrush}"/>
            <Button Content="¹/ₓ" Tag="1/x" Background="{StaticResource OperatorBrush}"/>
            <Button Content="x²" Tag="x²" Background="{StaticResource OperatorBrush}"/>
            <Button Content="²√x" Tag="√" Background="{StaticResource OperatorBrush}"/>
            <Button Content="÷" Tag="÷" Background="{StaticResource OperatorBrush}"/>
            <Button Content="7" Tag="7" Background="{StaticResource NumberBrush}" FontWeight="SemiBold"/>
            <Button Content="8" Tag="8" Background="{StaticResource NumberBrush}" FontWeight="SemiBold"/>
            <Button Content="9" Tag="9" Background="{StaticResource NumberBrush}" FontWeight="SemiBold"/>
            <Button Content="×" Tag="×" Background="{StaticResource OperatorBrush}"/>
            <Button Content="4" Tag="4" Background="{StaticResource NumberBrush}" FontWeight="SemiBold"/>
            <Button Content="5" Tag="5" Background="{StaticResource NumberBrush}" FontWeight="SemiBold"/>
            <Button Content="6" Tag="6" Background="{StaticResource NumberBrush}" FontWeight="SemiBold"/>
            <Button Content="−" Tag="−" Background="{StaticResource OperatorBrush}"/>
            <Button Content="1" Tag="1" Background="{StaticResource NumberBrush}" FontWeight="SemiBold"/>
            <Button Content="2" Tag="2" Background="{StaticResource NumberBrush}" FontWeight="SemiBold"/>
            <Button Content="3" Tag="3" Background="{StaticResource NumberBrush}" FontWeight="SemiBold"/>
            <Button Content="+" Tag="+" Background="{StaticResource OperatorBrush}"/>
            <Button Content="+/−" Tag="±" Background="{StaticResource NumberBrush}"/>
            <Button Content="0" Tag="0" Background="{StaticResource NumberBrush}" FontWeight="SemiBold"/>
            <Button Content="." Tag="." Background="{StaticResource NumberBrush}" FontWeight="SemiBold"/>
            <Button Content="=" Tag="=" Background="{StaticResource EqualsBrush}" Foreground="Black"/>
        </UniformGrid>
    </Grid>
</Window>
