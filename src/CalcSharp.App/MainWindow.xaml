<Window x:Class="CalcSharp.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calculator" Width="360" Height="560" MinWidth="320" MinHeight="500"
        Background="#202020" Foreground="White" FontFamily="Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown" PreviewTextInput="Window_PreviewTextInput">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Height="40">
            <Button x:Name="MenuButton" DockPanel.Dock="Left" Content="&#xE700;" FontFamily="Segoe MDL2 Assets"
                    Width="48" Background="Transparent" Click="MenuButton_Click" ToolTip="Open Navigation"/>
            <TextBlock x:Name="TitleText" Text="Standard" FontSize="16" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="8,0"/>
        </DockPanel>
        <ContentControl x:Name="Host" Grid.Row="1" Focusable="False"/>
        <Border x:Name="NavPanel" Grid.Row="1" Visibility="Collapsed" HorizontalAlignment="Left" Width="260"
                Background="#2B2B2B">
            <ListBox x:Name="NavList" Background="Transparent" BorderThickness="0" Foreground="White"
                     SelectionChanged="NavList_SelectionChanged">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#C5C5C5"
                                           Margin="8,10,0,4"/>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}" FontSize="15" Margin="12,6"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</Window>
