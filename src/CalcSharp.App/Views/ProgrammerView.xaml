<UserControl x:Class="CalcSharp.App.Views.ProgrammerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="RadixText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#C5C5C5"/>
            <Setter Property="Margin" Value="2,1"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="ExpressionText" Grid.Row="0" HorizontalAlignment="Right" Margin="8,4,8,0"
                   FontSize="14" Foreground="#C5C5C5" MinHeight="20"/>
        <Viewbox Grid.Row="1" HorizontalAlignment="Right" StretchDirection="DownOnly" Margin="8,0" Height="56">
            <TextBlock x:Name="DisplayText" Text="0" FontSize="40" FontWeight="SemiBold"/>
        </Viewbox>

        <!-- HEX / DEC / OCT / BIN -->
        <Grid Grid.Row="2" x:Name="RadixPanel" Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
            </Grid.RowDefinitions>
            <Button Grid.Row="0" Content="HEX" Tag="radix:Hex" x:Name="HexButton" FontSize="12" Background="Transparent" Padding="6,0"/>
            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="HexText" Style="{StaticResource RadixText}" Text="0" VerticalAlignment="Center"/>
            <Button Grid.Row="1" Content="DEC" Tag="radix:Dec" x:Name="DecButton" FontSize="12" Background="Transparent" Padding="6,0"/>
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DecText" Style="{StaticResource RadixText}" Text="0" VerticalAlignment="Center"/>
            <Button Grid.Row="2" Content="OCT" Tag="radix:Oct" x:Name="OctButton" FontSize="12" Background="Transparent" Padding="6,0"/>
            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="OctText" Style="{StaticResource RadixText}" Text="0" VerticalAlignment="Center"/>
            <Button Grid.Row="3" Content="BIN" Tag="radix:Bin" x:Name="BinButton" FontSize="12" Background="Transparent" Padding="6,0"/>
            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="BinText" Style="{StaticResource RadixText}" Text="0" VerticalAlignment="Center"/>
        </Grid>

        <!-- bit panel / bitwise / shift / word size / memory -->
        <Grid Grid.Row="3" Height="32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="⋮⋮⋮" ToolTip="Toggle bit-flip panel" Tag="bits" FontSize="12" Background="Transparent"/>
            <Button Grid.Column="1" x:Name="BitwiseButton" Content="Bitwise ▾" Tag="bitwise" FontSize="12" Background="Transparent"/>
            <Button Grid.Column="2" x:Name="ShiftButton" Content="Bit shift ▾" Tag="shiftmenu" FontSize="12" Background="Transparent"/>
            <Button Grid.Column="3" x:Name="WordButton" Content="QWORD" Tag="word" FontSize="12" Background="Transparent" ToolTip="Word size"/>
            <TextBlock Grid.Column="4" x:Name="MemoryIndicator" HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="12" Foreground="#4CC2FF"/>
        </Grid>

        <UniformGrid Grid.Row="4" x:Name="MemoryRow" Rows="1" Columns="5" Height="26">
            <Button Content="MC" Tag="MC" FontSize="11" Background="Transparent"/>
            <Button Content="MR" Tag="MR" FontSize="11" Background="Transparent"/>
            <Button Content="M+" Tag="M+" FontSize="11" Background="Transparent"/>
            <Button Content="M−" Tag="M-" FontSize="11" Background="Transparent"/>
            <Button Content="MS" Tag="MS" FontSize="11" Background="Transparent"/>
        </UniformGrid>

        <StackPanel Grid.Row="5" x:Name="BitPanel" Margin="0,4"/>

        <UniformGrid Grid.Row="6" x:Name="Keypad" Rows="6" Columns="5">
            <Button Content="A" Tag="A" Background="{StaticResource NumberBrush}"/>
            <Button Content="Lsh" Tag="Lsh" x:Name="LshButton" Background="{StaticResource OperatorBrush}" FontSize="14"/>
            <Button Content="Rsh" Tag="Rsh" x:Name="RshButton" Background="{StaticResource OperatorBrush}" FontSize="14"/>
            <Button Content="C" Tag="C" Background="{StaticResource OperatorBrush}"/>
            <Button Content="⌫" Tag="⌫" Background="{StaticResource OperatorBrush}"/>
            <Button Content="B" Tag="B" Background="{StaticResource NumberBrush}"/>
            <Button Content="(" Tag="(" Background="{StaticResource OperatorBrush}"/>
            <Button Content=")" Tag=")" Background="{StaticResource OperatorBrush}"/>
            <Button Content="%" Tag="Mod" Background="{StaticResource OperatorBrush}"/>
            <Button Content="÷" Tag="÷" Background="{StaticResource OperatorBrush}"/>
            <Button Content="C" Tag="C_" Background="{StaticResource NumberBrush}"/>
            <Button Content="7" Tag="7" Background="{StaticResource NumberBrush}" FontWeight="SemiBold"/>
            <Button Content="8" Tag="8" Background="{StaticResource NumberBrush}" FontWeight="SemiBold"/>
            <Button Content="9" Tag="9" Background="{StaticResource NumberBrush}" FontWeight="SemiBold"/>
            <Button Content="×" Tag="×" Background="{StaticResource OperatorBrush}"/>
            <Button Content="D" Tag="D" Background="{StaticResource NumberBrush}"/>
            <Button Content="4" Tag="4" Background="{StaticResource NumberBrush}" FontWeight="SemiBold"/>
            <Button Content="5" Tag="5" Background="{StaticResource NumberBrush}" FontWeight="SemiBold"/>
            <Button Content="6" Tag="6" Background="{StaticResource NumberBrush}" FontWeight="SemiBold"/>
            <Button Content="−" Tag="−" Background="{StaticResource OperatorBrush}"/>
            <Button Content="E" Tag="E" Background="{StaticResource NumberBrush}"/>
            <Button Content="1" Tag="1" Background="{StaticResource NumberBrush}" FontWeight="SemiBold"/>
            <Button Content="2" Tag="2" Background="{StaticResource NumberBrush}" FontWeight="SemiBold"/>
            <Button Content="3" Tag="3" Background="{StaticResource NumberBrush}" FontWeight="SemiBold"/>
            <Button Content="+" Tag="+" Background="{StaticResource OperatorBrush}"/>
            <Button Content="F" Tag="F" Background="{StaticResource NumberBrush}"/>
            <Button Content="+/−" Tag="±" Background="{StaticResource NumberBrush}"/>
            <Button Content="0" Tag="0" Background="{StaticResource NumberBrush}" FontWeight="SemiBold"/>
            <Button Content="." Tag="." IsEnabled="False" Background="{StaticResource NumberBrush}"/>
            <Button Content="=" Tag="=" Background="{StaticResource EqualsBrush}" Foreground="Black"/>
        </UniformGrid>

        <Popup x:Name="MenuPopup" StaysOpen="False" Placement="Bottom" PlacementTarget="{Binding ElementName=BitwiseButton}"
               AllowsTransparency="True">
            <Border Background="#2B2B2B" BorderBrush="#555" BorderThickness="1" CornerRadius="4" Padding="2">
                <UniformGrid x:Name="MenuGrid" Columns="3" Width="210"/>
            </Border>
        </Popup>
    </Grid>
</UserControl>
