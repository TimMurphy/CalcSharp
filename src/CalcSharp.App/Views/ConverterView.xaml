<UserControl x:Class="CalcSharp.App.Views.ConverterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="StatusText" Grid.Row="0" Margin="12,8,12,0" FontSize="12"
                   Foreground="#C5C5C5" Visibility="Collapsed"/>

        <!-- Field 0 -->
        <StackPanel x:Name="FromPanel" Grid.Row="1" Margin="8,8,8,0" Background="Transparent"
                    MouseLeftButtonDown="FromPanel_Click">
            <Viewbox HorizontalAlignment="Left" StretchDirection="DownOnly">
                <TextBlock x:Name="FromText" Text="0" FontSize="40" FontWeight="SemiBold"/>
            </Viewbox>
            <ComboBox x:Name="FromUnit" Margin="0,4,0,0" SelectionChanged="FromUnit_Changed"/>
        </StackPanel>

        <!-- Field 1 -->
        <StackPanel x:Name="ToPanel" Grid.Row="2" Margin="8,16,8,8" Background="Transparent"
                    MouseLeftButtonDown="ToPanel_Click">
            <Viewbox HorizontalAlignment="Left" StretchDirection="DownOnly">
                <TextBlock x:Name="ToText" Text="0" FontSize="40" FontWeight="SemiBold"/>
            </Viewbox>
            <ComboBox x:Name="ToUnit" Margin="0,4,0,0" SelectionChanged="ToUnit_Changed"/>
        </StackPanel>

        <TextBlock x:Name="UpdateText" Grid.Row="3" Margin="12,0,12,4" FontSize="12"
                   Foreground="#4CC2FF" Text="" Visibility="Collapsed"/>

        <UniformGrid x:Name="Keypad" Grid.Row="4" Rows="5" Columns="3" MinHeight="260">
            <Button Content="" Tag="" IsEnabled="False" Background="Transparent"/>
            <Button Content="CE" Tag="CE" Background="{StaticResource OperatorBrush}"/>
            <Button Content="⌫" Tag="⌫" Background="{StaticResource OperatorBrush}"/>
            <Button Content="7" Tag="7" Background="{StaticResource NumberBrush}" FontWeight="SemiBold"/>
            <Button Content="8" Tag="8" Background="{StaticResource NumberBrush}" FontWeight="SemiBold"/>
            <Button Content="9" Tag="9" Background="{StaticResource NumberBrush}" FontWeight="SemiBold"/>
            <Button Content="4" Tag="4" Background="{StaticResource NumberBrush}" FontWeight="SemiBold"/>
            <Button Content="5" Tag="5" Background="{StaticResource NumberBrush}" FontWeight="SemiBold"/>
            <Button Content="6" Tag="6" Background="{StaticResource NumberBrush}" FontWeight="SemiBold"/>
            <Button Content="1" Tag="1" Background="{StaticResource NumberBrush}" FontWeight="SemiBold"/>
            <Button Content="2" Tag="2" Background="{StaticResource NumberBrush}" FontWeight="SemiBold"/>
            <Button Content="3" Tag="3" Background="{StaticResource NumberBrush}" FontWeight="SemiBold"/>
            <Button Content="+/−" Tag="±" Background="{StaticResource NumberBrush}"/>
            <Button Content="0" Tag="0" Background="{StaticResource NumberBrush}" FontWeight="SemiBold"/>
            <Button Content="." Tag="." Background="{StaticResource NumberBrush}" FontWeight="SemiBold"/>
        </UniformGrid>
    </Grid>
</UserControl>
