<UserControl x:Class="CalcSharp.App.Views.ScientificView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="ExpressionText" Grid.Row="0" HorizontalAlignment="Right" Margin="8,8,8,0"
                   FontSize="14" Foreground="#C5C5C5" MinHeight="20"/>
        <Viewbox Grid.Row="1" Grid.RowSpan="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                 StretchDirection="DownOnly" Margin="8,0">
            <TextBlock x:Name="DisplayText" Text="0" FontSize="52" FontWeight="SemiBold"/>
        </Viewbox>

        <UniformGrid Grid.Row="3" Rows="1" Columns="6" x:Name="MemoryRow" Height="32">
            <Button Content="MC" Tag="MC" FontSize="12" Background="Transparent"/>
            <Button Content="MR" Tag="MR" FontSize="12" Background="Transparent"/>
            <Button Content="M+" Tag="M+" FontSize="12" Background="Transparent"/>
            <Button Content="M−" Tag="M-" FontSize="12" Background="Transparent"/>
            <Button Content="MS" Tag="MS" FontSize="12" Background="Transparent"/>
            <TextBlock x:Name="MemoryIndicator" Text="" HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="12" Foreground="#4CC2FF"/>
        </UniformGrid>

        <!-- DEG / F-E / hyp / C toggle row -->
        <UniformGrid Grid.Row="4" x:Name="ModeRow" Rows="1" Columns="4" Height="32">
            <Button Content="DEG" Tag="angle" FontSize="13" Background="Transparent"/>
            <Button Content="F-E" Tag="fe" FontSize="13" Background="Transparent"/>
            <Button Content="hyp" Tag="hyp" FontSize="13" Background="Transparent"/>
            <Button Content="C" Tag="C" FontSize="13" Background="Transparent"/>
        </UniformGrid>

        <!-- trigonometry row -->
        <UniformGrid Grid.Row="5" x:Name="TrigRow" Rows="1" Columns="6" Height="32">
            <Button Content="sin" Tag="sin" FontSize="13" Background="{StaticResource OperatorBrush}"/>
            <Button Content="cos" Tag="cos" FontSize="13" Background="{StaticResource OperatorBrush}"/>
            <Button Content="tan" Tag="tan" FontSize="13" Background="{StaticResource OperatorBrush}"/>
            <Button Content="sec" Tag="sec" FontSize="13" Background="{StaticResource OperatorBrush}"/>
            <Button Content="csc" Tag="csc" FontSize="13" Background="{StaticResource OperatorBrush}"/>
            <Button Content="cot" Tag="cot" FontSize="13" Background="{StaticResource OperatorBrush}"/>
        </UniformGrid>

        <UniformGrid x:Name="Keypad" Grid.Row="6" Rows="7" Columns="5">
            <Button Content="2nd" Tag="2nd" Background="{StaticResource OperatorBrush}" FontSize="15"/>
            <Button Content="π" Tag="pi" Background="{StaticResource OperatorBrush}"/>
            <Button Content="e" Tag="e" Background="{StaticResource OperatorBrush}"/>
            <Button Content="CE" Tag="CE" Background="{StaticResource OperatorBrush}"/>
            <Button Content="⌫" Tag="⌫" Background="{StaticResource OperatorBrush}"/>

            <Button Content="x²" Tag="x2" Background="{StaticResource OperatorBrush}"/>
            <Button Content="¹/ₓ" Tag="1/x" Background="{StaticResource OperatorBrush}"/>
            <Button Content="|x|" Tag="abs" Background="{StaticResource OperatorBrush}"/>
            <Button Content="exp" Tag="exp" Background="{StaticResource OperatorBrush}" FontSize="15"/>
            <Button Content="mod" Tag="mod" Background="{StaticResource OperatorBrush}" FontSize="15"/>

            <Button Content="²√x" Tag="sqrt" Background="{StaticResource OperatorBrush}"/>
            <Button Content="(" Tag="(" Background="{StaticResource OperatorBrush}"/>
            <Button Content=")" Tag=")" Background="{StaticResource OperatorBrush}"/>
            <Button Content="n!" Tag="n!" Background="{StaticResource OperatorBrush}"/>
            <Button Content="÷" Tag="÷" Background="{StaticResource OperatorBrush}"/>

            <Button Content="xʸ" Tag="xy" Background="{StaticResource OperatorBrush}"/>
            <Button Content="7" Tag="7" Background="{StaticResource NumberBrush}" FontWeight="SemiBold"/>
            <Button Content="8" Tag="8" Background="{StaticResource NumberBrush}" FontWeight="SemiBold"/>
            <Button Content="9" Tag="9" Background="{StaticResource NumberBrush}" FontWeight="SemiBold"/>
            <Button Content="×" Tag="×" Background="{StaticResource OperatorBrush}"/>

            <Button Content="10ˣ" Tag="10x" Background="{StaticResource OperatorBrush}"/>
            <Button Content="4" Tag="4" Background="{StaticResource NumberBrush}" FontWeight="SemiBold"/>
            <Button Content="5" Tag="5" Background="{StaticResource NumberBrush}" FontWeight="SemiBold"/>
            <Button Content="6" Tag="6" Background="{StaticResource NumberBrush}" FontWeight="SemiBold"/>
            <Button Content="−" Tag="−" Background="{StaticResource OperatorBrush}"/>

            <Button Content="log" Tag="log" Background="{StaticResource OperatorBrush}" FontSize="15"/>
            <Button Content="1" Tag="1" Background="{StaticResource NumberBrush}" FontWeight="SemiBold"/>
            <Button Content="2" Tag="2" Background="{StaticResource NumberBrush}" FontWeight="SemiBold"/>
            <Button Content="3" Tag="3" Background="{StaticResource NumberBrush}" FontWeight="SemiBold"/>
            <Button Content="+" Tag="+" Background="{StaticResource OperatorBrush}"/>

            <Button Content="ln" Tag="ln" Background="{StaticResource OperatorBrush}" FontSize="15"/>
            <Button Content="+/−" Tag="±" Background="{StaticResource NumberBrush}"/>
            <Button Content="0" Tag="0" Background="{StaticResource NumberBrush}" FontWeight="SemiBold"/>
            <Button Content="." Tag="." Background="{StaticResource NumberBrush}" FontWeight="SemiBold"/>
            <Button Content="=" Tag="=" Background="{StaticResource EqualsBrush}" Foreground="Black"/>
        </UniformGrid>
    </Grid>
</UserControl>
