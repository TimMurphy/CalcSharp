<UserControl x:Class="CalcSharp.App.Views.GraphingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#202020" Foreground="White" FontFamily="Segoe UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" MinWidth="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Function input panel -->
        <Grid Grid.Column="0" Margin="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="4,4,4,8">
                <Button DockPanel.Dock="Right" Content="+" Width="32" Height="32" FontSize="20"
                        ToolTip="Add equation" Background="{StaticResource OperatorBrush}"
                        Click="AddEquation_Click"/>
                <TextBlock Text="Function input" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="EquationList"/>
            </ScrollViewer>
        </Grid>

        <!-- Graph -->
        <Grid Grid.Column="1" Margin="4">
            <Border Background="#1B1B1B" BorderBrush="#3B3B3B" BorderThickness="1" ClipToBounds="True">
                <Canvas x:Name="GraphCanvas" Background="Transparent" ClipToBounds="True"
                        SizeChanged="GraphCanvas_SizeChanged"
                        MouseWheel="GraphCanvas_MouseWheel"
                        MouseLeftButtonDown="GraphCanvas_MouseLeftButtonDown"
                        MouseLeftButtonUp="GraphCanvas_MouseLeftButtonUp"
                        MouseMove="GraphCanvas_MouseMove"/>
            </Border>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8">
                <Button Content="+" Width="36" Height="36" ToolTip="Zoom in (Ctrl + plus)"
                        Background="{StaticResource NumberBrush}" Click="ZoomIn_Click"/>
                <Button Content="−" Width="36" Height="36" ToolTip="Zoom out (Ctrl + minus)"
                        Background="{StaticResource NumberBrush}" Click="ZoomOut_Click"/>
                <Button Content="⌂" Width="36" Height="36" ToolTip="Reset view"
                        Background="{StaticResource NumberBrush}" Click="ResetView_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
